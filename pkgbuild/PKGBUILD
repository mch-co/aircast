pkgname=aircast
pkgver=0.1.0
pkgrel=1
pkgdesc='AirPlay receiver: mirror an iPhone, iPad or Mac screen in a window'
arch=('x86_64' 'aarch64')
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-wayland' 'gstreamer' 'gst-plugins-base'
         'gst-plugins-good' 'gst-plugins-bad' 'gst-libav' 'avahi' 'libplist' 'openssl')
optdepends=('bluez: control the iPhone as a Bluetooth mouse and keyboard' 'ufw: offer to open the AirPlay ports on first launch' 'polkit: ask for the password to change the firewall')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/aircast "$pkgdir/usr/bin/aircast"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/aircast.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/aircast.svg"
  install -Dm644 "$startdir/aircast.desktop" "$pkgdir/usr/share/applications/aircast.desktop"
}
